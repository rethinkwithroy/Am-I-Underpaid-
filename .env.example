# ─────────────────────────────────────────────────────────────
# AI PROVIDER (server-side only — NEVER exposed to the browser)
# ─────────────────────────────────────────────────────────────
# Which provider to use: "deepseek" (default), "qwen", or "groq".
AI_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com) — cheap, strong Chinese-built model.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Qwen / Alibaba DashScope (https://dashscope.console.aliyun.com).
# Uses the OpenAI-compatible endpoint.
QWEN_API_KEY=your_qwen_api_key_here

# Groq (https://console.groq.com) — optional fallback / alternative.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model id for the selected provider.
# DeepSeek default: deepseek-chat | Qwen default: qwen-plus | Groq default: llama-3.1-8b-instant
# AI_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────────────
# BLS salary data (free, no key required — key only raises rate limits)
# ─────────────────────────────────────────────────────────────
BLS_API_KEY=optional_increases_rate_limits

# ─────────────────────────────────────────────────────────────
# Supabase (optional — anonymous analytics persistence)
# Service key is SERVER-SIDE ONLY. Never put it in the frontend.
# Leave blank to run fully stateless (no data stored).
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Leave blank to allow only same-origin requests (recommended).
# Example: https://aminunderpaid.vercel.app
ALLOWED_ORIGINS=
