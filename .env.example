# ─────────────────────────────────────────────────────────────
# AI PROVIDER (server-side only — NEVER exposed to the browser)
# ─────────────────────────────────────────────────────────────
# Which provider to use: "deepseek" (default), "qwen", or "groq".
AI_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com) — cheap, strong Chinese-built model.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Qwen / Alibaba DashScope (https://dashscope.console.aliyun.com) — OpenAI-compatible.
QWEN_API_KEY=your_qwen_api_key_here

# Groq (https://console.groq.com) — optional free-tier alternative.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model id for the selected provider.
# DeepSeek: deepseek-chat | Qwen: qwen-plus | Groq: llama-3.1-8b-instant
# AI_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────────────
# BLS salary data (free, no key required — key only raises rate limits)
# ─────────────────────────────────────────────────────────────
BLS_API_KEY=optional_increases_rate_limits

# ─────────────────────────────────────────────────────────────
# Google Sheets + Drive capture (optional — only used with user consent)
# Created via a Google Apps Script web app (see apps-script/Code.gs).
# The URL is a server-side secret; the browser never sees it.
# Leave blank to run fully stateless (nothing stored).
# ─────────────────────────────────────────────────────────────
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
# Comma-separated extra origins allowed to call the API.
# Leave blank to allow only same-origin requests (recommended).
ALLOWED_ORIGINS=
